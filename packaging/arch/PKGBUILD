pkgname=eqxear
pkgver=0.1.1
pkgrel=1
pkgdesc='Live system parametric equalizer and spectrum analyzer for PipeWire'
arch=('x86_64')
url='https://github.com/jerodkdunn/EQxEar'
license=('Apache-2.0' 'ISC')
depends=('python>=3.11' 'python-gobject' 'python-cairo' 'gtk4' 'pipewire' 'pipewire-audio' 'pipewire-pulse' 'wireplumber' 'libpulse' 'glibc' 'hicolor-icon-theme')
makedepends=('lv2')
install=eqxear.install
source=("$url/releases/download/v$pkgver/eqxear-$pkgver.tar.gz")
sha256sums=('f1512c869655a4e239b9c52d308d745f63b672bc1f2a085aef43457e3d9671e0')

build() {
  cd "$srcdir/eqxear-$pkgver"
  make
}

check() {
  cd "$srcdir/eqxear-$pkgver"
  XDG_CACHE_HOME="$srcdir/check-cache" python3 -m unittest discover -s tests -v
}

package() {
  cd "$srcdir/eqxear-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
