#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Launch EQxEar from this checkout, regardless of the working directory."""
import os
from pathlib import Path
import runpy
import sys

if sys.version_info < (3, 11):
    raise SystemExit('EQxEar requires Python 3.11 or newer.')
root = Path(__file__).resolve().parent
sys.path.insert(0, str(root))
if len(sys.argv) == 2 and sys.argv[1] in ('--version', '-V'):
    from eqxear import __version__
    print(f'EQxEar {__version__}')
    raise SystemExit(0)
os.chdir(root)
runpy.run_module('eqxear', run_name='__main__', alter_sys=True)
